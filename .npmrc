# Same false-positive kempo-files hits: this extension peer-depends on kempo, kempo-files and
# kempo-server directly, and kempo (and kempo-files) peer-depend on kempo-server too — several
# paths to the same package that npm's strict peer resolver rejects even though every range
# genuinely overlaps. legacy-peer-deps sidesteps that rather than dropping a peer dependency this
# package really does have on its own.
legacy-peer-deps=true
